set -g status-justify "absolute-centre"
set -g status "on"
set -g status-left-style "none"
set -g message-command-style "fg=<%= base05_h %>,bg=<%= base00_h %>"
set -g status-right-style "none"
set -g pane-active-border-style "fg=<%= base0B_h %>"
set -g message-style "fg=<%= base0C_h %>,bg=<%= base00_h %>"
set -g pane-border-style "fg=<%= base0B_h %>"

# Bottom Status-line
set -g status-style "none,bg=<%= base00_h %>"
set -g status-right-length "15"
set -g status-left-length "15"
setw -g window-status-activity-style "none"
setw -g window-status-separator "   "

# Text for far left and right
set -g status-left ""
set -g status-right "%b %d %H:%M"

# Format for a single window
setw -g window-status-style "none,fg=<%= base0A_h %>,bg=<%= base00_h %>"

setw -g window-status-format "\
#[fg=<%= base03_h %>,bg=<%= base00_h %>]#W"

setw -g window-status-current-format "\
#[fg=<%= base07_h %>,bg=<%= base00_h %>]#W"

# custom changes
set-option -g history-limit 20000
set -g mouse on
set-option -sg escape-time 10 # makes vim more responsive
# nvim :checkhealth recommends this
set -g default-terminal "screen-256color"
set-option -g focus-events on
# for true colors
set-option -a terminal-features "$TERM:RGB"

if-shell 'uname | grep --quiet Linux' 'bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "wl-copy"'
if-shell 'uname | grep --quiet Darwin' 'bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"'

# https://unix.stackexchange.com/questions/12032/how-to-create-a-new-window-on-the-current-directory-in-tmux
# -h means horizontal split
# -c <start_directory>
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -c "#{pane_current_path}"

# Allow the passthrough of color escapes to let base16_h work
set -g allow-passthrough "on"
